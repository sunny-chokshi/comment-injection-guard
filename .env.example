# Copy to your host's secret store. Never commit real values.
GUARD_API_KEYS=change-me-1,change-me-2
RATE_PER_MIN=30
GUARD_DETECTOR=either        # regex | classifier | either
GUARD_MODE=strip_all         # strip_all (default, best review accuracy) | strip_flagged
REVIEWER_BACKEND=none        # none | mock | ollama | anthropic
REVIEWER_MODEL=claude-opus-5-5
# Required for a paid reviewer. The service refuses review calls without them.
MONTHLY_CAP_USD=5
REVIEWER_PRICE_IN_PER_MTOK=
REVIEWER_PRICE_OUT_PER_MTOK=
ANTHROPIC_API_KEY=
